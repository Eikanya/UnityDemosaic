<Project>

  <!-- 全仓库唯一的版本号来源：csproj 的 <Version> 与 [BepInPlugin] 均取自这里 -->
  <PropertyGroup>
    <DemosaicVersion>1.7.9</DemosaicVersion>

    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>DemosaicPlugin</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- 设计性抑制：MSB3277(引用版本冲突) / CS0649;CS0169(Unity 字段由运行时注入) / CS8618(可空警告) -->
    <NoWarn>$(NoWarn);MSB3277;CS0649;CS0169;CS8618</NoWarn>

    <Version>$(DemosaicVersion)</Version>
    <AssemblyVersion>$(DemosaicVersion).0</AssemblyVersion>
    <FileVersion>$(DemosaicVersion).0</FileVersion>
  </PropertyGroup>

  <!-- 由 MSBuild 生成版本常量，避免 csproj 与 BepInPlugin 特性两处硬编码 -->
  <Target Name="GenerateDemosaicVersion" BeforeTargets="BeforeCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)DemosaicVersion.g.cs"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="namespace DemosaicPlugin%3B%0A%0Ainternal static class DemosaicVersion%0A{%0A    public const string Value = &quot;$(DemosaicVersion)&quot;%3B%0A}" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)DemosaicVersion.g.cs" />
    </ItemGroup>
  </Target>

</Project>
